<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Browser Controls Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/btnBrowserBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface" />

        <ImageView
            android:id="@+id/btnBrowserForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/on_surface" />

        <ImageView
            android:id="@+id/btnBrowserReload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/on_surface" />

        <ImageView
            android:id="@+id/btnBrowserHome"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:padding="6dp"
            android:src="@drawable/ic_home"
            app:tint="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowserFavorite"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:minWidth="44dp"
            android:text="☆"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:contentDescription="Add or remove favorite" />

        <!-- Address Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/browser_search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_muted"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnClearUrl"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:src="@drawable/ic_clear"
                android:visibility="gone"
                app:tint="@color/on_surface_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Shortcuts / Bookmarks -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavorites"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorites" />
<com.google.android.material.chip.Chip
                android:id="@+id/chipBookmarkManuals"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ManualsLib" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBookmarkGoogle"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Google" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBookmarkTestPdf"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Test PDF Download" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Web Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary"
        android:visibility="gone" />

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
